\newlabel{eq:sigma_Aeff_adv}{{50}{14}{}{equation.5.50}{}}
\citation{Chluba2021}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Detection SNR for the foam amplitude $A_{\rm  eff}$ as a function of foam exponent $\alpha $ ($A_\alpha =1$, $D_C=13.87$\,Gpc). Blue curves: marginal SNR (all four parameters $A_{\rm  eff},T_0,\mu ,y$ free). Red curves: conditional SNR ($\mu ,y$ held fixed), which is $\sim 27\times $ higher. Line styles denote the instrument: solid FIRAS, dashed PIXIE, dash-dotted SuperPIXIE, dotted Voyage~2050, with forecast $\mu $-sensitivities scaled relative to FIRAS \cite  {Chluba2021}. The marginal lower bounds (SNR\,$=1.645$, one-sided $95\%$ CL) cluster at $\alpha \approx 0.55$--$0.59$, illustrating the logarithmic saturation of the bound with sensitivity. The dotted horizontal line marks SNR\,$=1.645$ (one-sided $95\%$ CL); vertical dashed lines mark the spectroscopic lower bound from GRB\,221009A ($\alpha \gtrsim 0.63$) and the holographic prediction $\alpha =2/3$.}}{15}{figure.1}\protected@file@percent }
\newlabel{fig:cmb_snr}{{1}{15}{Detection SNR for the foam amplitude $A_{\rm eff}$ as a function of foam exponent $\alpha $ ($A_\alpha =1$, $D_C=13.87$\,Gpc). Blue curves: marginal SNR (all four parameters $A_{\rm eff},T_0,\mu ,y$ free). Red curves: conditional SNR ($\mu ,y$ held fixed), which is $\sim 27\times $ higher. Line styles denote the instrument: solid FIRAS, dashed PIXIE, dash-dotted SuperPIXIE, dotted Voyage~2050, with forecast $\mu $-sensitivities scaled relative to FIRAS \cite {Chluba2021}. The marginal lower bounds (SNR\,$=1.645$, one-sided $95\%$ CL) cluster at $\alpha \approx 0.55$--$0.59$, illustrating the logarithmic saturation of the bound with sensitivity. The dotted horizontal line marks SNR\,$=1.645$ (one-sided $95\%$ CL); vertical dashed lines mark the spectroscopic lower bound from GRB\,221009A ($\alpha \gtrsim 0.63$) and the holographic prediction $\alpha =2/3$}{figure.1}{}}
