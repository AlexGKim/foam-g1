\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Marginal foam-detection thresholds (one-sided $95\%$ CL): \emph  {lower} bounds on the exponent $\alpha $ ($A_\alpha =1$), since the foam signal $\sigma _\ell ^2\propto (\ell _P/D_C)^{2\alpha }$ decreases with $\alpha $ and a non-detection therefore excludes small $\alpha $. FIRAS is from the data fit (Section~\ref {sec:CMB_degeneracy}); PIXIE, SuperPIXIE, and Voyage~2050 from the Fisher forecast scaled by their published $\mu $-sensitivities~\cite  {Chluba2021}. The three forecast entries ($0.578$, $0.583$, $0.587$) round to $0.58$ (Voyage to $0.59$); the thresholds increase monotonically.}}{14}{table.1}\protected@file@percent }
\newlabel{tab:thresholds}{{I}{14}{Marginal foam-detection thresholds (one-sided $95\%$ CL): \emph {lower} bounds on the exponent $\alpha $ ($A_\alpha =1$), since the foam signal $\sigma _\ell ^2\propto (\ell _P/D_C)^{2\alpha }$ decreases with $\alpha $ and a non-detection therefore excludes small $\alpha $. FIRAS is from the data fit (Section~\ref {sec:CMB_degeneracy}); PIXIE, SuperPIXIE, and Voyage~2050 from the Fisher forecast scaled by their published $\mu $-sensitivities~\cite {Chluba2021}. The three forecast entries ($0.578$, $0.583$, $0.587$) round to $0.58$ (Voyage to $0.59$); the thresholds increase monotonically}{table.1}{}}
\newlabel{eq:dIdA}{{48}{14}{}{equation.5.48}{}}
